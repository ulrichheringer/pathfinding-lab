<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="using:PathfindingLab.ViewModels" mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700" x:Class="PathfindingLab.Views.MainView" x:DataType="vm:MainViewModel">
  <ScrollViewer><StackPanel Margin="24" Spacing="16" MaxWidth="860" HorizontalAlignment="Center">
    <TextBlock Text="Pathfinding Lab" FontSize="30" FontWeight="Bold"/><TextBlock Text="Compare BFS, DFS, Dijkstra e A* em uma grade interativa." Opacity="0.75"/>
    <StackPanel Orientation="Horizontal" Spacing="10"><ComboBox ItemsSource="{Binding Algorithms}" SelectedItem="{Binding Algorithm}" Width="160"/><Button Content="Buscar caminho" Command="{Binding AnimatePathCommand}"/><Button Content="Limpar obstáculos" Command="{Binding ClearWallsCommand}"/></StackPanel>
    <Border Background="#E2E8F0" Padding="8" CornerRadius="8"><ItemsControl ItemsSource="{Binding Cells}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="20"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="32" Height="32" Margin="1" CornerRadius="3" Background="{Binding Fill}" BorderBrush="#CBD5E1" BorderThickness="1" PointerPressed="CellPointerPressed"><TextBlock Text="{Binding Label}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="Bold"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border>
    <TextBlock Text="{Binding Status}" FontSize="16"/>
  </StackPanel></ScrollViewer>
</UserControl>
